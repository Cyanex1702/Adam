{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ADAM Desktop",
  "version": "0.20.2",
  "identifier": "local.adam.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ADAM \u00b7 Local workspace",
        "width": 1280,
        "height": 820,
        "minWidth": 780,
        "minHeight": 600,
        "backgroundColor": "#f5f4ef"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "A private local assistant workspace",
    "resources": {
      "resources/backend/": "backend/",
      "resources/adam.compact.toml": "adam.compact.toml",
      "resources/LICENSE": "LICENSE",
      "resources/THIRD_PARTY.md": "THIRD_PARTY.md"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerHooks": "windows/hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
